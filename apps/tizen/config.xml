<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://cabinet.local/tv"
        version="1.0.0"
        viewmodes="maximized">

  <name>Cabinet</name>
  <description>Cabinet — your retro game library on Samsung TV.</description>
  <author href="https://github.com/cabinet-roms/cabinet" email="dev@cabinet.local">Cabinet</author>

  <!-- Packaged local shell (index.html): registers remote keys and loads the
       hosted Cabinet TV app in a frame. A packaged entry (unlike a hosted app)
       keeps the tv.inputdevice API available. -->
  <content src="index.html"/>
  <icon src="icon.png"/>

  <tizen:application id="CabinetTv1.cabinet" package="CabinetTv1" required_version="5.5"/>
  <tizen:profile name="tv-samsung"/>

  <!-- Network access for the hosted app + EmulatorJS CDN. -->
  <access origin="https://cabinet-eta-gilt.vercel.app" subdomains="true"/>
  <access origin="https://cdn.emulatorjs.org" subdomains="true"/>
  <tizen:allow-navigation>cabinet-eta-gilt.vercel.app cdn.emulatorjs.org</tizen:allow-navigation>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/tizen.tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
