{
  "name": "cabinet-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cabinet web app — library, TV mode and admin dashboard (Vercel + Neon).",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "npm run build -w @cabinet/core && npm run build -w @cabinet/db",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:seed": "npm run build -w @cabinet/db && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@cabinet/core": "*",
    "@cabinet/db": "*",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^11.11.9",
    "next": "^14.2.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
