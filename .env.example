# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection string — used at runtime on Vercel (Neon "-pooler" host).
DATABASE_URL="postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
# Direct/unpooled connection string — used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# ─── Sessions ────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# ─── Admin dashboard key-password ────────────────────────────────────────────
# Option A (dev / simple): the admin key itself. Never commit the real value.
ADMIN_KEY="cabinet-dev-admin-key"
# Option B (recommended for production): scrypt hash of the admin key, so the
# key itself is not stored on the server. Generate with:
#   npm run keyvault -- hash
ADMIN_KEY_HASH=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin of the deployment, used for absolute links + security checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
